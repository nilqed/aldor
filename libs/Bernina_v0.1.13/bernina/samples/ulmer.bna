/* ulmer.bna: 3rd order example from Ulmer */

L := D^3+(2/x*(64*x^5-49*x^4+54*x^3+189*x^2-243*x+81)/(72*x^7-288*x^6+496*x^5
	-406*x^4+153*x^3+54*x^2-135*x+54))*D^2+(1/36*(9477*x+2106*x^4+
	29565*x^3-26514*x^2-24840*x^5+24872*x^6+2304*x^8-13464*x^7-1458)/x^2
	/(189*x-189*x^2-99*x^3+559*x^4-902*x^5+784*x^6-360*x^7+72*x^8-54))*D+(
	-1/72*(4608*x^6-28872*x^5+67240*x^4-115560*x^3+131166*x^2-78165*x+27135)
	/x/(189*x-189*x^2-99*x^3+559*x^4-902*x^5+784*x^6-360*x^7+72*x^8-54));

/* symmetric 3rd power has 1-dimensional kernel */
V := symmetricKernel(L, 3);

sol := element(V, 1);

maple(sol);

tex(sol);

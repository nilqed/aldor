n := 10;
Ldense := n*x*D^2-x*D+n^2;
/* Polynomial solutions */
Kp := kernel(Ldense, 1);
tex(degree(element(Kp, 1)));
/* Rational solutions */
Kr := kernel(Ldense);
tex(degree(element(Kr, 1)));


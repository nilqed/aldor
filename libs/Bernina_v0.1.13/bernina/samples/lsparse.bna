n := 5;
Lsparse := (x^(n^3)*n^6*x-x^(n^3)*n^3*x)*D+(x^(n^3)*n^9-3*x^(n^3)
*n^6+2*x^(n^3)*n^3)+(-x^3-x^3*x^(n^3))*D^3-x^(n^3)*n^3*x^2*D^2;
/* Polynomial solutions */
Kp := kernel(Lsparse, 1);
tex(Kp);
/* Rational solutions */
Kr := kernel(Lsparse);
tex(Kr);


/* f36.bna: Example with Galois group F36 from
    M.van Hoeij & J.A.Weil,
    An Algorithm for Computing Invariants of Differential Galois Groups,
    Proceedings of MEGA'96   */

L := D^3 + 5*(9*x^2+14*x+9)/(48*x^2*(x+1)^2) * D
     -5*(81*x^3+185*x^2+229*x+81)/(432*x^3*(x+1)^3);

/* symmetric 6th power has 1-dimensional kernel, but a 2-dim invariant space */
V := symmetricKernel(L, 6);
maple(V);

/* symmetric 9th power has 1-dimensional kernel, and a 1-dim invariant space */
V := symmetricKernel(L, 9);
maple(V);

/* symmetric 12th power has 2-dimensional kernel, and a 5-dim invariant space */
V := symmetricKernel(L, 12);
maple(V);

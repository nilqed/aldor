/* expsol.bna: examples of exponential solutions */


/* Has no rational nor radical solutions, but has an exponential solution */
L := D*(D+x);
tex(kernel(L));
tex(radicalSolutions(L));
tex(exponentialSolutions(L));

/* Has an interesting exponential solution */
L := 4*D^2+(4*x+6*x^2-1)/x^6;
tex(exponentialSolutions(L));

/* Has an interesting exponential solution */
L := ((2*x^3)*(2*x^4-x^3-x^2+x-1))*D^2+
(x*(-8*x^7+14*x^5-6*x^4-9*x^3+18*x^2-15*x+2))*D+
((-24*x^7+4*x^6-2*x^5-5*x^4-2*x^3+18*x^2-16*x+3));
tex(exponentialSolutions(L));

/* Has no exponential solution */
L := (x^2-3)*(x+1)*(x^2-x+1)*D^2+x*D+(x^2-3)*(x^2+x+2);
tex(exponentialSolutions(L));

/* Has 2 exponential solutions (completely reducible) */
L := (3*x^4-7*x^3+x^2-23*x+2)*(x^2+1)^4*D^2
	+(6*x^7-24*x^6+11*x^5-127*x^4+20*x^3-118*x^2-9*x+25)*(x^2+1)^2*D
	+90*x^6-18*x^5+7*x^8-8*x^7-2*x^2+2*x+122*x^4-24*x^3+23;
tex(exponentialSolutions(L));


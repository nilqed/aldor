# libname must be properly set for bernina and Max

with(Max):

read `dsolve2.maple`:

unprotect('Order3'):
Order3 := 'Order3':

Order3[dsolve3] := Order3Dsolve3;

Order3Dsolve3 := proc(L, D, x, grponly) local LL, r, n, ric, i, grp; global y;
	if grponly = 1 then grp := true; else grp := false; fi;
	if degree(L, D) < 3 then Order2Dsolve(L, D, x, true, grp);
	else
	    if grp then
	      print(`Computing the Galois group of the differential equation:`);
	    else print(`Solving the differential equation:`); fi;
	    print(L);
	    y := 'y';
	    LL := symmetricSquareRoot(L, D, x);
	    if LL <> 0 then Order3SymSquare(LL, D, x, y, grp);
	    elif grp then RiccatiPolynomial(L, D, x, y, 'group');
	    else
		r := RiccatiPolynomial(L, D, x, y);
		n := nops(r);
		if n=1 then print(`The equation has no Liouvillian solutions`);
		else
			ric := [seq(r[i],i=2..n)];
			LiouvillianSolution(L, D, ric, n-1, y, x, grp);
		fi;
	    fi;
	fi;
end;

# Solves the symmetric square of L
Order3SymSquare := proc(L, D, x, y, grp) local sol, n;
	sol := Order2Dsolve(L, D, x, false, grp);
	if grp then
		cat(`Symmetric square of a 2nd order equation with group `,sol);
	elif type(sol, list) then
		n := nops(sol);
		if n = 0 then DESol(coeff(L,D,2)*diff(y(x),x$2)
					+ coeff(L,D,1) * diff(y(x),x)
					+ coeff(L,D,0) * y(x), y(x))^2;
		elif n = 1 then sol[1]^2;
		else [sol[1]^2, sol[1]*sol[2], sol[2]^2]; fi;
	else sol^2;
	fi;
end;

save `Order3.m`;
done;

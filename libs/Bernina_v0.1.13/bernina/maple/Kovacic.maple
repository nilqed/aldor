# libname must be properly set for bernina and isolde

with(bernina): with(ISOLDE):

unprotect('Kovacic'):
Kovacic := 'Kovacic':

Kovacic[dsolve2] := KovacicDsolve2;
Kovacic[verify2] := KovacicVerify;

KovacicDsolve2 := proc(L, D, x) local dbx, n, deg, mindeg, index, i; global y;
	print(`Solving the differential equation:`);
	print(L);
	y := 'y';
	dbx := Darboux(L, D, x, y);
	n := linalg[vectdim](dbx);
	if n = 1 and dbx[1] = 0 then NonLiouvillianSolver(L, D, x);
	elif n = 0 then Kovacictryexponentialsols(L, D, x);
	else
		mindeg := degree(dbx[1], y); index := 1;
		for i to n-1 do
			deg := degree(dbx[i+1], y);
			if deg < mindeg then mindeg := deg; index := i+1; fi;
		od;
		if mindeg = 1 then Kovacicdegree1(dbx, n, y, x);
		elif mindeg = 2 then Kovacicdegree2(dbx[index], y, x);
		else Kovacicdegreen(dbx[index], y, x);
		fi;
	fi; end;

Kovacicexpint1 := proc(p, y, x)
	if degree(p, y) = 1 then exp(int(solve(p, y), x)) else NULL fi; end;

Kovacicdegree1 := proc(curves, n, y, x) local i, l;
	l := [seq(Kovacicexpint1(curves[i], y, x), i = 1..n)];
	if nops(l) = 1 then l[1] else l; fi; end;

Kovacicdegree2 := proc(curve, y, x) local i, s, n;
	s := [solve(curve, y)];
	n := nops(s);
	if n = 1 then exp(int(s[1], y), x);
	else [seq(exp(int(s[i], x)), i = 1..n)]; fi; end;

Kovacicdegreen := proc(curve, y, x) local p, d;
	p := Kovacicsqrfreepart(curve, y);
	d := degree(p, y);
	if d = 1 then Kovacicdegree1([p], 1, y, x);
	elif d = 2 then Kovacicdegree2(p, y, x);
	else exp(Int(RootOf(curve, y), x)); fi; end;

Kovacicsqrfreepart := proc(p, x) local l, i;
	l := sqrfree(p, x);
	convert([seq(l[2][i][1], i = 1..nops(l[2]))], `*`); end;
	
Kovacictryexponentialsols := proc(L, D, x) local s;
	s := expsolde(L, D, x, `basis`);
	if nops(s) = 0 then NonLiouvillianSolver(L, D, x);
	else s[1]; fi; end;
	
KovacicVerify := proc(L, D, x, sol)
	normal(coeff(L, D, 2) * diff(sol, x$2) + coeff(L, D, 1) * diff(sol, x)
	+ coeff(L, D, 0) * sol); end;

NonLiouvillianSolver := proc(L, D, x)
	print(`The equation has no Liouvillian solutions`);
	print(`Trying to find special function solutions...`);
	dsolveSpecial(L, D, x); end;

# Special function solver
read `special.maple`:

# save `Kovacic.m`;
# done;

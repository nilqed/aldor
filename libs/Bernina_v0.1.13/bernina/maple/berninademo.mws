*,$F,\"\"%\"\"\"7&F3F3,$F*\"\"$F.7&F*F3F3F*" }}}{EXCHG {PARA 0 "> " 0 
"" {MPLTEXT 1 0 27 "K := rationalKernel(A,D,x);" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "6#>%\"KG-%'matrixG6#7&7%\"\"!\"\"\"!\"\"7%,&*$)%\"xG\"\"&
\"\"\"#F+\"\"$*$)F1\"\"#F3#F,F5,(F/#\"#8\"#7F6F9F1#!\"$\"\"%,(F/#F,F=F

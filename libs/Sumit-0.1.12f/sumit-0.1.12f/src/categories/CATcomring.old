#include "sumit"

#if ASDOC
\thistype{CommutativeRing}
\History{Manuel Bronstein}{22/11/94}{created}
\History{Manuel Bronstein}{24/09/96}{added exactFactors}
\History{Manuel Bronstein}{6/12/96}{added karatsubaCutoff}
\Usage{\this: Category}
\Descr{\this~is the category of \sumit commutative rings.}
\begin{exports}
\category{SumitRing}\\
canonicalUnitNormal?: & $\to$ Boolean &
Test for canonical associate representatives\\
exactQuotient: & (\%, \%) $\to$ Partial \% & Exact quotient\\
karatsubaCutoff: & $\to$ SingleInteger & Cutoff for Karatsuba in $R[x]$\\
quotient: & (\%, \%) $\to$ \% & Exact quotient\\
reciprocal: & \% $\to$ Partial \% & Inverse\\
unitNormal: & \% $\to$ (\%,\%,\%) & Representative of the associate class\\
unit?: & \% $\to$ Boolean & Test whether an element is a unit\\
\end{exports}
#endif

CommutativeRing: Category == SumitRing with {
	canonicalUnitNormal?: Boolean;
#if ASDOC
\aspage{canonicalUnitNormal}
\Usage{\name}
\Signature{}{Boolean}
\Retval{Returns \true~if {\tt unitNormal} is canonical in the following sense:
if $x = v x'$ for some unit $v$ and ${\tt unitNormal}(x)$ returns
$(u, y, u^{-1})$ and ${\tt unitNormal}(x')$ returns $(u', y', u'{}^{-1})$,
then $y = y'$.}
\seealso{unitNormal(\this), unit?(\this)}
#endif
	exactFactors: % -> List %;
#if ASDOC
\aspage{exactFactors}
\Usage{\name~x}
\Signature{\%}{List \%}
\Params{ {\em x} & \% & A ring element\\ }
\Retval{Returns $[x_1,\dots,x_n]$ such that each $x_i$ divides $x$ exactly.}
\seealso{exactQuotient(\this)}
#endif
	exactQuotient: (%, %) -> Partial %;
#if ASDOC
\aspage{exactQuotient}
\Usage{\name(x, y)}
\Signature{(\%, \%)}{Partial \%}
\Params{
{\em x} & \% & The numerator\\
{\em y} & \% & The denominator\\
}
\Retval{Returns $q$ such that $x = q\, y$ if such a $q$ exists,
\failed~otherwise.}
\seealso{exactFactors(\this), quotient(\this)}
#endif
	karatsubaCutoff: SingleInteger;
#if ASDOC
\aspage{karatsubaCutoff}
\Usage{\name}
\Signature{}{SingleInteger}
\Retval{Returns $n$ such that the Karatsuba multiplication is used
in $R[x]$ for polynomials of degree greater than or equal to $n$.}
\Remarks{If this constant is $0$, then Karatsuba multiplication is
not used at all in $R[x]$. The default value is always $0$ so you only
need to define another value if you want Karatsuba to be used in $R[x]$.}
#endif
	quotient: (%, %) -> %;
#if ASDOC
\aspage{quotient}
\Usage{\name(x, y)}
\Signature{(\%, \%)}{\%}
\Params{
{\em x} & \% & The numerator\\
{\em y} & \% & The denominator\\
}
\Retval{Returns $q$ such that $x = q\, y$ if such a $q$ exists.}
\Remarks{Use this function only when it is guaranteed that y divides x
exactly. If there is a nonzero remainder, this function may produce a wrong
quotient instead of an error, so use the exactQuotient function when
there is the possibility of a nonzero remainder. When however y is known
to divide x exactly, then quotient can have better efficiency than the other
divisions.}
\seealso{exactQuotient(\this)}
#endif
	reciprocal: % -> Partial %;
#if ASDOC
\aspage{reciprocal}
\Usage{\name~x}
\Signature{\%}{Partial \%}
\Params{ {\em x} & \% & An element of the ring\\ }
\Retval{Returns $y$ such that $x\, y = 1$ if such a $y$ exists,
\failed~otherwise.}
#endif
	unitNormal: % -> (%, %, %);
#if ASDOC
\aspage{unitNormal}
\Signature{\%}{(\%, \%. \%)}
\Params{ {\em x} & \% & An element of the ring\\ }
\Retval{ Returns $(y, u, u^{-1})$ such that $x = u y$ and $u u^{-1} = 1$.}
\seealso{canonicalUnitNormal?(\this), unit?(\this)}
#endif
	unit?: % -> Boolean;
#if ASDOC
\aspage{unit?}
\Usage{\name~x}
\Signature{\%}{Boolean}
\Params{ {\em x} & \% & An element of the ring\\ }
\Retval{ Returns \true~if $x$ is a unit, \ie $x \, y = 1$ for some $y$,
\false~otherwise.}
\seealso{canonicalUnitNormal?(\this), unitNormal(\this)}
#endif
	default {
		karatsubaCutoff:SingleInteger	== 0;
		canonicalUnitNormal?:Boolean	== false;
		unitNormal(x:%):(%, %, %)	== (x, 1, 1);
		reciprocal(x:%):Partial(%) 	== exactQuotient(1, x);
		exactFactors(x:%):List %	== [x];

		quotient(x:%, y:%):% == {
			import from Partial %;
			retract exactQuotient(x, y);
		}

		unit?(x:%):Boolean == {
			import from Partial %;
			~(zero? x or failed? reciprocal x)
		}
	}
}

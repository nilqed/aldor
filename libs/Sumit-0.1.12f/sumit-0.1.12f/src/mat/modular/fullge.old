------------------------------ fullge.as ------------------------------------
-- TO BE INCLUDED IN modpge.as
-- Case of prime greater than half-word, use mod_* for product

	local fullRowEch!(a:M, ra:Z, ca:Z, b:M, rb:Z, cb:Z, p:Z):(A,Z,A,Z) == {
		macro PRODUCT(aa, bb, cc) == mod_*(aa, bb, cc);
		d:Z := 1;
		pp:A := new ra;
		for i in 1..ra repeat pp.i := i;
		st:A := new(ra, next ca);
		c:Z := 1; r:Z := 1;
		while r <= ra and c <= ca repeat {
			l := r;
			while l <= ra and a(pp.l)(c) = 0 repeat l := next l;
			if l <= ra then {
				st.r := c;
				if l ~= r then {
					temp := pp.l;
					pp.l := pp.r;
					pp.r := temp;
					d := -d;
				}
				arcinv := mod_/(1, a(pp.r)(c), p);
				for i in next(r)..ra repeat {
					f := PRODUCT(a(pp.i)(c), arcinv, p);
					for j in next(c)..ca repeat {
						pr := PRODUCT(f, a(pp.r)(j), p);
						a(pp.i)(j) :=
							mod_-(a(pp.i)(j),pr,p);
					}
					for j in 1..cb repeat {
						pr := PRODUCT(f, b(pp.r)(j), p);
						b(pp.i)(j) :=
							mod_-(b(pp.i)(j),pr,p);
					}
				}
				r := next r;
			}
			c := next c;
		}
		(pp, prev r, st, d);
	}

	local fullDeter(a:M, ra:Z, ca:Z, pp:A, r:Z, st:A, d:Z, p:Z):Z == {
		macro PRODUCT(aa, bb, cc) == mod_*(aa, bb, cc);
		r < ra => 0;
		det:Z := { d = 1 => 1; prev p };
		for i in 1..r repeat
			det := PRODUCT(det, a(pp.i)(i), p);
		det;
	}

	local fullDep(gen:Generator A, n:Z, p:Z):(M, A, Z, Z) == {
		macro PRODUCT(aa, bb, cc) == mod_*(aa, bb, cc);
		a:M := new n;
		for i in 1..n repeat a.i := new(next n, 0);
		pp:A := new n;
		for i in 1..n repeat pp.i := i;
		r:Z := 1;
		independent?:Boolean := true;
		while independent? for v in gen repeat {
			for i in 1..n repeat a.i.r := v.i;
			for j in 1..prev r repeat {
				for i in next(j)..n repeat {
					pr := PRODUCT(a(pp.i)(j),a(pp.j)(r),p);
					a(pp.i)(r) := mod_-(a(pp.i)(r), pr, p);
				}
			}
			l := r;
			while l <= n and a(pp.l)(r) = 0 repeat l := next l;
			if l = next(n) then {
				independent? := false;
				iterate;
			} 
			if l ~= r then {
				temp := pp.l;
				pp.l := pp.r;
				pp.r := temp;
			}
			inv := mod_/(1, a(pp.r)(r), p);
			for i in next(r)..n repeat
				a(pp.i)(r) := PRODUCT(a(pp.i)(r), inv, p);
			r := next r;
		}
		(a, pp, r, 1);
	}

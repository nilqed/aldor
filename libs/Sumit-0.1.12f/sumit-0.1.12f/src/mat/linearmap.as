LinearMapToMatrix(R:SumitRing, M:AbelianGroup, MAT:MatrixCategory R): with {
	matrix: (M -> M, ARR M, (M, Z) -> R, M -> Z) -> MAT;
	matrix: (M -> M, M, Z, (M, Z) -> R, M -> Z) -> MAT;
	matrix: (ARR M, (M, Z) -> R, M -> Z) -> MAT;

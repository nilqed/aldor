} == add {
	-- coef must have second argument starting with 1
	-- size must be at least 1 for nonzero elements
	matrix(L:M -> M, basis:ARR M, coef:(M, Z) -> R, size:M -> Z):MAT ==
		matrix([L b for b in basis], coef, size);

	-- coef must have second argument starting with 1
	-- size must be at least 1 for nonzero elements
	matrix(space:ARR M, coef:(M, Z) -> R, size:M -> Z):MAT == {
		import from I;
		g:Z := 0;
		for b in space | ~zero? b repeat
			if g < (d := size b) then g := d;
		matrix(space, coef, retract g);
	}

	-- coef must have second argument starting with 1
	local matrix(space:ARR M, coef:(M, Z) -> R, rows:I):MAT == {
		import from Z;
		m := #space;
		zero? rows => zero(1, m);
		mat := zero(rows, m);
		for j in 1..m | ~zero?(b := space.j) repeat
			for i in 1..rows repeat mat(i, j) := coef(b, i::Z);
		mat;
	}

	-- coef must have second argument starting with 1
	-- size must be at least 1 for nonzero elements
	matrix(L:M -> M, v:M, cols:Z, coef:(M, Z) -> R, size:M -> Z):MAT == {
		import from I, M;
		orbit:ARR M := new(m := retract cols, 0);
		for i in 1..prev m repeat {
			orbit.i := v;
			v := L v;
		}
		orbit.m := v;
		matrix(orbit, coef, size);
	}

	if R has IntegralDomain then {
		-- coef must have second argument starting with 1
		-- size must be at least 1 for nonzero elements
		undeterminedCoefficients(L:M -> M, basis:ARR M,
				coef:(M,Z) -> R, size:M -> Z):List VEC R == {
					import from MAT;
					nullSpace matrix(L, basis, coef, size);
		}

		-- coef must have second argument starting with 1
		cyclicLinearDependences(L:M -> M, v:M, n:Z, coef:(M, Z) -> R):
			List VEC R == {
				import from MAT;
				nullSpace matrix(L, v, next n,coef,(x:M):Z+->n);
		}
	}
}

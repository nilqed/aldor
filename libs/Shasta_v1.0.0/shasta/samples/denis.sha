d1 := (x+3)*(x + 6)*(x + 1)*(x + 5)*x;
d2 := (x + 6)*(x + 2);
d3 := (x + 6)*(x + 1)*(x + 5)*x;
d4 := x + 6;

A := system((x - 1)*(x + 2)*(x + 3)*(x + 6)*(x + 1)/d1,
		x*(x^6 + 11*x^5 + 41*x^4 + 65*x^3 + 50*x^2-36)/d1,
		0,
		-6*(x + 2)*(x + 3)*(x + 6)*(x + 1)*x/d1,

		0, x^2/d2, 0, 0,

		-(x + 6)*(x + 1)*(x - 1)/d3,
		x*(x^5 + 7*x^4 + 11*x^3 + 4*x^2 - 5*x + 6)/d3,
		(x + 6)*(x + 1)*(x + 5)*x/d3,
		-(x + 6)*(x + 1)*x*3*(x + 3)/d3,

		0, -x^2/d4, 0, (x + 6)/d4);

maple(A);
K := kernel(A);
maple(K);


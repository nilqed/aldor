an := (n+3)*(5*n^2+18*n+17)*(n^5+22*n^4+193*n^3+844*n^2+1840*n+1599)
                *(35*n^12+777*n^11+7744*n^10+45766*n^9+178455*n^8+483349*n^7
                +932168*n^6+1289968*n^5+1272162*n^4+873128*n^3+396817*n^2
                +107648*n+13184);

b := (n+1)*(5*n^2+28*n+40)*(n^5+2*n^4+n^3-1)
                *(35*n^12+1197*n^11+18601*n^10+173641*n^9+1084359*n^8
                +4771975*n^7+15174249*n^6+35131483*n^5+58780078*n^4
